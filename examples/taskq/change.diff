+def register(name):
+    def wrap(cls):
+        EXPORTERS[name] = cls
+        return cls
+    return wrap
+
+
+class BaseExporter(abc.ABC):
+    """Base class for all exporters. Subclass and register to add a format."""
+
+    @abc.abstractmethod
+    def write(self, tasks, out):
+        ...
+
+    def rows(self, tasks):
+        return [{k: t.get(k, "") for k in FIELDS} for t in tasks]
+
+
+@register("csv")
+class CsvExporter(BaseExporter):
+    def write(self, tasks, out):
+        writer = csv.DictWriter(out, fieldnames=FIELDS)
+        writer.writeheader()
+        writer.writerows(self.rows(tasks))
+
+
+@register("json")
+class JsonExporter(BaseExporter):
+    def write(self, tasks, out):
+        json.dump(self.rows(tasks), out, indent=2)
+        out.write("\n")
 
 
